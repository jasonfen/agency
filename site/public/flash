#!/bin/sh
# Writes the agency installer to a USB stick, on macOS or Linux.
#
#   curl -fsSL https://agency.makors.xyz/flash | sh
#
# It downloads the newest installer ISO and Caligula (a small disk-writing
# tool, github.com/ifd3f/caligula), then lets you pick the stick. Caligula
# checks the ISO's SHA-256 before writing, shows the disk's size and model,
# asks before it erases anything, and verifies the stick afterwards.
#
# On Windows, download the ISO from https://agency.makors.xyz and write it
# with Rufus (DD Image mode) or balenaEtcher.
#
# It sends two anonymous events to PostHog, so we can count flashes: one when
# it starts and one when the stick is written. They carry the OS, the CPU and
# the installer version, and a random ID made for this run, nothing else.
# DO_NOT_TRACK=1 turns them off.

set -eu

ISO_BASE="https://iso.makors.xyz"
CALIGULA_VERSION="v0.5.0"

say() { printf '%s\n' "$*"; }

run_id=$(cat /proc/sys/kernel/random/uuid 2>/dev/null || uuidgen 2>/dev/null || echo "$$-$(date +%s)")
# Sends one event in the background, and never fails or waits.
count() {
  [ -z "${DO_NOT_TRACK:-}" ] || [ "$DO_NOT_TRACK" = 0 ] || return 0
  curl -fsS --max-time 5 -o /dev/null -H 'Content-Type: application/json' \
    -d "{\"api_key\":\"phc_yBGvjZW4wAfvVSufdysvJxTWdoyQAtP7fcxrg4khcif4\",\"event\":\"$1\",\"distinct_id\":\"$run_id\",\"properties\":{\"\$process_person_profile\":false,\"os\":\"$(uname -s)\",\"arch\":\"$(uname -m)\",\"iso_sha256\":\"${hash:-}\"}}" \
    https://us.i.posthog.com/i/v0/e/ >/dev/null 2>&1 &
}
die() { printf 'agency: %s\n' "$*" >&2; exit 1; }

case "$(uname -s)-$(uname -m)" in
  Darwin-arm64) target=aarch64-darwin sum=5fef54f50b209ce0fcd6883432a2dd96119a211ef5f441902aa078719ae6ac28 ;;
  Darwin-x86_64) target=x86_64-darwin sum=0e8528d6c4d375bf14cd3e8be3ab76b5cda9a464e9c39cc7f41769153f26ad29 ;;
  Linux-x86_64) target=x86_64-linux sum=470da9381d2ac44bbd54485ac8c8afcc23fd2aecbce98cd1aba815d1ef5ed3ed ;;
  Linux-aarch64 | Linux-arm64) target=aarch64-linux sum=9dd0cea2080bfa51e5b9a50c8048632e9767c1b269784e6902663566f53dbf75 ;;
  *) die "this works on macOS and Linux. On Windows, use Rufus or balenaEtcher (see https://agency.makors.xyz)." ;;
esac

if command -v sha256sum >/dev/null 2>&1; then
  sha256() { sha256sum "$1" | cut -d' ' -f1; }
else
  sha256() { shasum -a 256 "$1" | cut -d' ' -f1; }
fi

[ -r /dev/tty ] || die "this needs a terminal to pick the USB stick."

# The ISO goes to Downloads, so a second run reuses it.
dir="$HOME/Downloads"
[ -d "$dir" ] || dir="${TMPDIR:-/tmp}"

meta=$(curl -fsSL "$ISO_BASE/latest.json") || die "could not reach $ISO_BASE"
field() { printf '%s' "$meta" | tr -d '\n' | sed -n "s/.*\"$1\": *\"\{0,1\}\([^\",}]*\).*/\1/p"; }
url="$ISO_BASE/$(field url)"
hash=$(field sha256)
size=$(field sizeBytes)
[ -n "$hash" ] || die "the installer's checksum is missing from latest.json"
count flash_started
iso="$dir/agency-installer-$(printf '%s' "$hash" | cut -c1-12).iso"

if [ ! -f "$iso" ] || [ "$(wc -c <"$iso" | tr -d ' ')" != "$size" ]; then
  say "Downloading the installer ($((size / 1000000)) MB) ..."
  curl -fL --retry 3 -C - -o "$iso" "$url" || die "download failed, run this again to resume"
fi

tool="${TMPDIR:-/tmp}/caligula-$CALIGULA_VERSION"
if [ ! -x "$tool" ] || [ "$(sha256 "$tool")" != "$sum" ]; then
  curl -fsSL -o "$tool" "https://github.com/ifd3f/caligula/releases/download/$CALIGULA_VERSION/caligula-$target" ||
    die "could not download Caligula"
  [ "$(sha256 "$tool")" = "$sum" ] || { rm -f "$tool"; die "Caligula's checksum does not match"; }
  chmod +x "$tool"
fi

printf 'Plug in a USB stick (8 GB+, it gets wiped) and press Enter. ' && read -r _ </dev/tty

# On macOS, Caligula's list includes every disk image (simulators and so on),
# so pick from the external physical disks here instead.
set --
if [ "$(uname -s)" = Darwin ]; then
  disks=$(diskutil list external physical | sed -n 's|^\(/dev/disk[0-9]*\) .*|\1|p')
  [ -n "$disks" ] || die "no USB stick found"
  n=0
  for d in $disks; do
    n=$((n + 1))
    info=$(diskutil info "$d")
    name=$(printf '%s\n' "$info" | sed -n 's/.*Media Name: *//p')
    dsize=$(printf '%s\n' "$info" | sed -n 's/.*Disk Size: *\([^(]*[^ (]\).*/\1/p')
    say "  $n) $d  $name, $dsize"
  done
  pick=1
  if [ "$n" -gt 1 ]; then printf 'Which one? ' && read -r pick </dev/tty; fi
  # shellcheck disable=SC2086
  out=$(printf '%s\n' $disks | sed -n "${pick}p")
  [ -n "$out" ] || die "no disk $pick"
  printf 'Erase %s? [y/N] ' "$out" && read -r yes </dev/tty
  [ "$yes" = y ] || [ "$yes" = Y ] || die "nothing written"
  diskutil unmountDisk "$out" >/dev/null
  set -- -o "$out"
fi

# Caligula's own switch to root is unreliable on macOS, so use sudo here.
run=""
[ "$(id -u)" = 0 ] || run=sudo
$run "$tool" burn "$iso" -s "sha256-$hash" --hash-of raw -z none --root never "$@" </dev/tty
count flash_written

say "Done. Boot the laptop from it, with Secure Boot off and TPM on in the BIOS."
