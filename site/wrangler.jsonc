{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agency-landing",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true,
  "routes": [{ "pattern": "agency.makors.xyz", "custom_domain": true }]
}
